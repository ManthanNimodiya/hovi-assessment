# Copy to .env (or set in Koyeb). All values are TEST values: synthetic data only.
PORT=3000
# Public URL of the service. Wallet apps on phones must reach it (use the HTTPS Koyeb URL in production).
BASE_URL=http://localhost:3000
# Protects Licence Authority admin actions (issue / revoke).
ADMIN_KEY=demo-admin-key
# Encryption key for the Askar stores (test value).
STORE_KEY=driveproof-test-store-key
# Optional: use Postgres instead of local SQLite files, e.g. postgres://user:password@host:5432/dbname
# DATABASE_URL=
