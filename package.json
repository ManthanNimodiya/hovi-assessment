{
  "name": "driveproof",
  "version": "1.0.0",
  "private": true,
  "description": "Digital driving licence (OpenID4VCI) used to prove eligibility for a car rental (OpenID4VP), built with Credo-TS.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "e2e": "tsx scripts/e2e.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@credo-ts/askar": "^0.7.4",
    "@credo-ts/core": "^0.7.4",
    "@credo-ts/node": "^0.7.4",
    "@credo-ts/openid4vc": "^0.7.4",
    "@openwallet-foundation/askar-nodejs": "^0.6.1",
    "express": "^5.3.0",
    "qrcode": "^1.5.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.9.3"
  }
}
